# Prisma uses the mysql provider for both MySQL and MariaDB.
DATABASE_URL="mysql://besight:change-me@127.0.0.1:3306/besight_crm"
SHADOW_DATABASE_URL="mysql://besight:change-me@127.0.0.1:3306/besight_crm_shadow"
# Max DB connections per server instance. On Vercel it defaults to 3 (each
# serverless instance holds its own pool); raise only if MySQL max_connections
# allows it. Ignored when DATABASE_URL already has ?connectionLimit=.
# The DB must be reachable from the internet (Vercel has no fixed IPs), so
# 127.0.0.1 only works locally.
DATABASE_POOL_LIMIT=""

# Supabase Edge Function. Keep the token server-side: never prefix it with NEXT_PUBLIC_.
CRM_CUSTOMERS_URL="https://nmetbatfjiagpjbbmowp.supabase.co/functions/v1/crm-customers/tradingview"
CRM_CUSTOMERS_TOKEN=""

LOT_CHECK_BASE_URL="https://ai.besight.net/webhook"
DEFAULT_REQUIRED_LOTS="3"
INDICATOR_RENEWAL_MONTHS="1"

# ── Auth.js (NextAuth v5) ──
# Signs + encrypts the session JWT. Generate with: openssl rand -hex 32
# Changing it invalidates every existing session.
AUTH_SECRET=""
# Public origin of THIS app (not a broker/CRM host). Local dev only — on Vercel
# you can leave it unset: Auth.js auto-detects the host (trustHost: true).
AUTH_URL="http://localhost:3000"

# Social sign-in. Each provider is only enabled when BOTH of its values are set.
# Register these exact absolute redirect URIs with the provider (they cannot be
# relative, and must match what Auth.js calls):
#   Google:   https://console.cloud.google.com/apis/credentials
#             <AUTH_URL>/api/auth/callback/google
#   Facebook: https://developers.facebook.com/apps → Facebook Login
#             <AUTH_URL>/api/auth/callback/facebook
#   LINE:     https://developers.line.biz/console/ → LINE Login channel
#             Callback URL: <AUTH_URL>/api/auth/callback/line
#             (email scope needs applying for in the channel's OpenID Connect tab)
# Add your production origin (wherever this app is actually deployed) to both
# the origins and redirect-URI lists when you go live.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
LINE_CLIENT_ID=""
LINE_CLIENT_SECRET=""

# ── VIP social linking (member-verified connects) ──
# Telegram Login Widget (https://core.telegram.org/widgets/login): set the
# domain in BotFather, then put the bot's @username (no @) below. The token
# verifies login hashes server-side — never expose it to the client.
TELEGRAM_BOT_USERNAME=""
TELEGRAM_BOT_TOKEN=""
# Discord OAuth2 (https://discord.com/developers/applications → OAuth2):
#   Redirect: <AUTH_URL>/api/social/discord/callback/
#   Scope needed: identify
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
# LINE Login for linking (may reuse the sign-in channel above, or use a
# dedicated channel so linking never touches sessions):
#   Callback URL: <AUTH_URL>/api/social/line/callback/
#   Scopes needed: profile + openid
LINE_LOGIN_CHANNEL_ID=""
LINE_LOGIN_CHANNEL_SECRET=""
# Invite links are admin-editable in CRM Settings instead of env.

# Protects /api/cron/*. Use a long random value in production.
CRON_SECRET=""

# ── CRM gate (second password layer for /crm) ──
# After signing in as an admin, every /crm page AND every /api/crm/* call
# additionally requires this shared password (asked once per browser, stays
# unlocked 12h). Leave empty to disable the gate (admin session is enough).
# The unlock cookie is HMAC-signed with GATE_SECRET (falls back to
# AUTH_SECRET) — changing either value below instantly locks everyone out.
CRM_GATE_PASSWORD=""
GATE_SECRET=""

# Owner admin created by `npm run db:seed` (email/password sign-in).
ADMIN_EMAIL="danaiwut077@gmail.com"
ADMIN_PASSWORD=""
